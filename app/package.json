{
  "name": "cairn",
  "version": "0.1.0",
  "private": true,
  "description": "Ask the W3C accessibility standards. Retrieval-augmented answers in Chinese or English, every sentence quoted and checked against the W3C text.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "ingest": "node scripts/ingest.js",
    "eval:retrieval": "node scripts/eval-retrieval.js",
    "test": "node --test",
    "ingest:monash": "node scripts/ingest-monash.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "@huggingface/transformers": "4.3.2",
    "@langchain/textsplitters": "1.0.2",
    "@orama/orama": "3.1.18",
    "@orama/plugin-data-persistence": "3.1.18",
    "cheerio": "1.2.0",
    "express": "5.3.0"
  }
}
